# Laravel .gitignore – ignore generated and sensitive files
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor
/docker
/docs
/tests
.env
.env.backup
.env.production
.phpactor.json
.gemini/
.kilo/
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json

# Laravel Storage
/storage/app/public/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!/storage/app/public/.gitignore
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
/storage/pail

# IDE Helpers
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# Scratch Files & Temporary
*.log
.DS_Store
Thumbs.db
check_db.php
test_query.php
scratch*.php
# Windows "Copy" backups (e.g. "database - Copy (2).sqlite")
*Copy*
*.bak
*.tmp
